#!/usr/bin/env bash
# Antes de hacer push:
#   1. Si pusheas a `main` → pide confirmación interactiva por /dev/tty.
#      Si no hay /dev/tty (Sourcetree, GitHub Desktop, IDE, CI…) → bloquea.
#   2. Lanza tests + build para evitar romper main / CI.
#
# Salida puntual (no recomendado): git push --no-verify

set -eu

# IMPORTANTE: git invoca el hook pasándole los refs vía STDIN. Por eso NO
# podemos usar `[[ -t 0 ]]` para detectar terminal: stdin nunca es TTY aquí.
# El test correcto es intentar abrir /dev/tty.

# Leer todos los refs que vienen por stdin antes de tocar /dev/tty
PUSHING_TO_MAIN=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    PUSHING_TO_MAIN=1
  fi
done

if [[ "$PUSHING_TO_MAIN" -eq 1 ]]; then
  echo ""
  echo "⛔  Estás intentando empujar DIRECTAMENTE a main."
  echo ""
  echo "   El flujo normal es:"
  echo "      1. Crear una rama:      ./scripts/new-feature.sh feat \"descripción\""
  echo "      2. Pushear tu rama:     git push -u origin <tu-rama>"
  echo "      3. Abrir Pull Request en GitHub"
  echo "      4. Review + merge a main desde la UI"
  echo ""

  # Intentamos abrir /dev/tty para preguntar de forma interactiva
  # (subshell para que el error "Device not configured" no se imprima)
  if { exec 3</dev/tty; } 2>/dev/null; then
    # Hay terminal interactiva — preguntar
    printf "   ¿Estás seguro? [y/N]: " >&2
    read -r ANS <&3
    exec 3<&-
    if [[ ! "$ANS" =~ ^[Yy] ]]; then
      echo "   Cancelado. Crea una rama y abre PR."
      exit 1
    fi
  else
    # Sin TTY (Sourcetree / GUI / CI) — bloquear con instrucciones
    echo "   No detecto terminal interactiva (Sourcetree / GitHub Desktop / IDE)."
    echo "   Para confirmar, hazlo desde Terminal.app:"
    echo "      cd $(pwd)"
    echo "      git push origin main"
    echo ""
    exit 1
  fi
fi

# ── Tests + build (no requieren TTY) ─────────────────────────────────────
echo "→ npm test"
if ! npm test --silent; then
  echo ""
  echo "❌  Tests fallando — corrige antes de empujar."
  echo "    (Para saltar puntualmente: git push --no-verify)"
  exit 1
fi

echo "→ npm run build"
if ! npm run build --silent; then
  echo ""
  echo "❌  Build falló — corrige antes de empujar."
  echo "    (Para saltar puntualmente: git push --no-verify)"
  exit 1
fi

echo "✓ Tests y build OK"
